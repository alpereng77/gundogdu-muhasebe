# Öztoprak İnşaat Muhasebe Sistemi
# En doğru kurulum: alan adının kök klasörünü (document root) bu klasördeki "public" klasörü yapmaktır.
# Hosting panelinde bu ayarlanamıyorsa bu dosya, istekleri "public" klasörüne yönlendirir
# ve uygulama dosyalarına (.env, storage, vendor vb.) dışarıdan erişimi engeller.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Gizli ve uygulama klasörleri dışarıya kapalı
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]

    # Her şeyi public klasörüne gönder
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
